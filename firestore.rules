rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidHour(h) {
      return h is int && h >= 0 && h <= 23;
    }

    function isValidMinute(m) {
      return m is int && m >= 0 && m <= 59;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 100 &&
             isValidHour(data.morningHour) &&
             isValidMinute(data.morningMinute) &&
             isValidHour(data.afternoonHour) &&
             isValidMinute(data.afternoonMinute) &&
             isValidHour(data.nightHour) &&
             isValidMinute(data.nightMinute) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMedicine(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 80 &&
             data.dosage is string &&
             data.dosage.size() >= 1 &&
             data.dosage.size() <= 40 &&
             data.form is string &&
             data.form in ['TABLET', 'CAPSULE', 'SYRUP', 'INJECTION', 'DROPS', 'INHALER'] &&
             data.mealRelation is string &&
             data.mealRelation in ['BEFORE_MEAL', 'AFTER_MEAL', 'WITH_MEAL', 'ANYTIME'] &&
             data.notes is string &&
             data.notes.size() <= 200 &&
             data.morningEnabled is bool &&
             isValidHour(data.morningHour) &&
             isValidMinute(data.morningMinute) &&
             data.afternoonEnabled is bool &&
             isValidHour(data.afternoonHour) &&
             isValidMinute(data.afternoonMinute) &&
             data.nightEnabled is bool &&
             isValidHour(data.nightHour) &&
             isValidMinute(data.nightMinute) &&
             data.active is bool &&
             (data.morningEnabled || data.afternoonEnabled || data.nightEnabled) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDoseLog(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.medicineId is string &&
             data.medicineId.size() >= 1 &&
             data.medicineId.size() <= 128 &&
             data.medicineName is string &&
             data.medicineName.size() >= 1 &&
             data.medicineName.size() <= 80 &&
             data.dosage is string &&
             data.dosage.size() >= 1 &&
             data.dosage.size() <= 40 &&
             data.dateKey is string &&
             data.dateKey.size() == 10 &&
             data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.slot is string &&
             data.slot in ['MORNING', 'AFTERNOON', 'NIGHT'] &&
             data.status is string &&
             data.status in ['TAKEN', 'SKIPPED'] &&
             data.scheduledTimeLabel is string &&
             data.scheduledTimeLabel.size() >= 1 &&
             data.scheduledTimeLabel.size() <= 20 &&
             data.takenAtEpochMillis is int &&
             data.takenAtEpochMillis >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName',
                         'morningHour', 'morningMinute',
                         'afternoonHour', 'afternoonMinute',
                         'nightHour', 'nightMinute',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName',
                         'morningHour', 'morningMinute',
                         'afternoonHour', 'afternoonMinute',
                         'nightHour', 'nightMinute',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'morningHour', 'morningMinute',
                         'afternoonHour', 'afternoonMinute',
                         'nightHour', 'nightMinute',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /medicines/{medicineId} {
        allow get: if isOwner(userId) && isValidId(medicineId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(medicineId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'dosage', 'form', 'mealRelation', 'notes',
                           'morningEnabled', 'morningHour', 'morningMinute',
                           'afternoonEnabled', 'afternoonHour', 'afternoonMinute',
                           'nightEnabled', 'nightHour', 'nightMinute',
                           'active', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'dosage', 'form', 'mealRelation', 'notes',
                           'morningEnabled', 'morningHour', 'morningMinute',
                           'afternoonEnabled', 'afternoonHour', 'afternoonMinute',
                           'nightEnabled', 'nightHour', 'nightMinute',
                           'active', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMedicine(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(medicineId) &&
                         isValidMedicine(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'dosage', 'form', 'mealRelation', 'notes',
                             'morningEnabled', 'morningHour', 'morningMinute',
                             'afternoonEnabled', 'afternoonHour', 'afternoonMinute',
                             'nightEnabled', 'nightHour', 'nightMinute',
                             'active', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(medicineId);
      }

      match /doseLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll([
                           'userId', 'medicineId', 'medicineName', 'dosage',
                           'dateKey', 'slot', 'status', 'scheduledTimeLabel',
                           'takenAtEpochMillis', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'medicineId', 'medicineName', 'dosage',
                           'dateKey', 'slot', 'status', 'scheduledTimeLabel',
                           'takenAtEpochMillis', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidDoseLog(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidDoseLog(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().medicineId == existing().medicineId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().slot == existing().slot &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'status', 'takenAtEpochMillis', 'medicineName', 'dosage',
                           'scheduledTimeLabel', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}
